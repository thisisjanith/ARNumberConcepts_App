  - {fileID: 8300000, guid: c77e8ab699e0dcc4883b668334244089, type: 3}
  - {fileID: 8300000, guid: 21de5f1bc1c7a974397fd85e37be26f1, type: 3}
  - {fileID: 8300000, guid: 1ec4832459d245d4586947c0c055ef2d, type: 3}
  transcripts:
  - "Hello, Explorer! You found the Altar of Light! But oh no\u2014the magic Sun-Stone
    is broken into pieces. The woods are becoming dark and cold. We need to fix the
    stone to bring back the light! Can you touch 4 pieces and put them back? Let\u2019s
    make the circle whole again!"
  - Great job! You found the first piece. Now, 1 out of 4 pieces is back. That is
    one-fourth of the stone!
  - "You found another! Now 2 out of 4 pieces are back. Look\u2014that is half of
    the circle! We call this two-fourths."
  - "Only one more left! Now 3 out of 4 pieces are in place. That is three-fourths
    of the magic stone. It\u2019s starting to glow!"
  - 'You did it! All 4 pieces are back. 4 out of 4 means we have 1 whole circle again!
    The Sun-Stone is fixed, and the light is back. You are a math hero! '
  totalPieces: 4
  maxCharsPerPage: 100
  pulseScale: 1.2
  animationDuration: 0.5
  completionColor: {r: 0, g: 1, b: 1, a: 1}
